# Copy to .env and edit. Anything unset falls back to the defaults in
# app/config.py — a bare checkout runs against a local SQLite file with no
# further setup.

# A real SQLAlchemy URL. Swap this for Postgres when there is one to point
# at; nothing else in the app changes.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/parts_ordering
DATABASE_URL=sqlite:///./parts_ordering.db

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
