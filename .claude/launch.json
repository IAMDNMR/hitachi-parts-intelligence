{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hcme-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/node_modules/vite/bin/vite.js", "frontend", "--config", "frontend/vite.config.ts"],
      "port": 5173
    },
    {
      "name": "hcme-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"],
      "port": 8000
    }
  ]
}
