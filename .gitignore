# local database file should still never be committed.
*.db

# Local configuration. .env.example is committed; the real one is not.
.env
.env.*
.env.local
neo4j/.env
**/.env

# Scratch output from backend/video-processing/ survey scripts
backend/video-processing/survey-s01/
frontend/.test-build/

