# Dependencies and build output
frontend/node_modules
frontend/dist

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Runtime state, not source. Nothing in this repo currently generates a .db
# file (the previous ordering backend that did was removed), but any stray
# local database file should still never be committed.
*.db

# Local configuration. .env.example is committed; the real one is not.
.env
.env.*
.env.local
neo4j/.env
**/.env

# Scratch output from backend/video-processing/ survey scripts
backend/video-processing/survey-s01/
frontend/.test-build/

# Official machine images, mirrored from backend/data/HITACHI_MACHINE_IMAGES/
# by backend/catalogue-generation/build-web-images.py and build-cutouts.py.
# ~96 MB of binaries; rebuildable, so not committed.
frontend/public/machines/
