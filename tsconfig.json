{
  // TypeScript covers The Ground only. Sections 01-05 stay as JSX and are
  // deliberately not migrated, so `allowJs` is on (the Ground reuses a couple
  // of existing hooks) while `checkJs` stays off (the untyped existing site
  // is not type-checked).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  // Both TypeScript modules are checked: the Ground and the ordering
  // application. Ordering was left out when it was written and stayed out —
  // two thousand lines compiled by esbuild, which strips types without ever
  // looking at them, so nothing checked it at all. It is in now.
  //
  // Sections 01-05 remain deliberately absent. They are JSX, they are not
  // being migrated, and `allowJs` above is on only so the Ground can import a
  // couple of their hooks.
  "include": ["src/ground", "src/ordering", "src/vite-env.d.ts"]
}
